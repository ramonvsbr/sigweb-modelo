# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# Banco (PostGIS)
DB_PASSWORD=troque-esta-senha

# Portas no host (só loopback). O padrão serve para testar; no servidor, se a 8000
# já estiver ocupada, mude e use a mesma porta no nginx.
API_PORT=8000
ADMIN_PORT=8002

# Painel Django
# Gere uma chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=False
# Em produção, inclua o domínio do site: localhost,127.0.0.1,sigweb.exemplo.org
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção, com HTTPS: https://sigweb.exemplo.org
DJANGO_CSRF_TRUSTED_ORIGINS=
# Ligue (True) só atrás de um proxy com HTTPS; em http://localhost deixe False.
DJANGO_USAR_HTTPS=False

# Usuário administrador, criado na primeira subida (se ainda não existir).
# Depois de entrar, pode apagar a senha daqui.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha-tambem
DJANGO_SUPERUSER_EMAIL=admin@example.com
